---
interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;

const footerLinks = [
  {
    title: 'Navigate',
    links: [
      { href: '/', label: 'Home' },
      { href: '/about', label: 'About' },
      { href: '/events', label: 'Events' },
      { href: '/team', label: 'Team' },
    ],
  },
  {
    title: 'Community',
    links: [
      { href: '/achievements', label: 'Achievements' },
      { href: '/contact', label: 'Contact' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { href: '/privacy-policy', label: 'Privacy Policy' },
      { href: '/terms-and-conditions', label: 'Terms & Conditions' },
    ],
  },
];
---

<footer class:list={['border-t', dark ? 'border-[#2a2a2a] bg-[#0a0a0a]' : 'border-hairline bg-canvas']}>
  <div class="mx-auto max-w-[1200px] px-6 py-10 md:py-16">
    <!-- Brand -->
    <div class="mb-8 md:mb-12">
      <span class:list={['font-mono text-sm font-semibold tracking-wide uppercase', dark ? 'text-[#f0f0f0]' : 'text-ink']}>
        TCET AAAI
      </span>
      <p class:list={['mt-3 text-sm leading-6', dark ? 'text-[#b0b0b0]' : 'text-body']}>
        The official student chapter of Association for the Advancement of Artificial Intelligence at Thakur College of Engineering & Technology.
      </p>
    </div>

    <!-- Link columns -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 sm:gap-8 md:gap-12">
      {footerLinks.map((col) => (
        <div>
          <h4 class:list={['mb-3 text-sm font-semibold', dark ? 'text-[#f0f0f0]' : 'text-ink']}>{col.title}</h4>
          <ul class="flex flex-col gap-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={['text-sm no-underline transition-colors', dark ? 'text-[#b0b0b0] hover:text-[#f0f0f0]' : 'text-body hover:text-ink']}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom section -->
    <div class:list={['mt-8 flex flex-col items-center justify-between gap-4 border-t pt-8 md:mt-12 md:flex-row', dark ? 'border-[#2a2a2a]' : 'border-hairline']}>
      <p class:list={['text-xs', dark ? 'text-[#707070]' : 'text-mute']}>
        &copy; {new Date().getFullYear()} TCET AAAI. All rights reserved.
      </p>
      <div class="flex gap-4">
        <a href="https://www.instagram.com/aaai.tcet/" target="_blank" rel="noopener noreferrer" class:list={['flex h-11 w-11 items-center justify-center transition-colors', dark ? 'text-[#707070] hover:text-[#f0f0f0]' : 'text-mute hover:text-ink']} aria-label="Instagram">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="5"></circle>
            <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/tcet-aaai" target="_blank" rel="noopener noreferrer" class:list={['flex h-11 w-11 items-center justify-center transition-colors', dark ? 'text-[#707070] hover:text-[#f0f0f0]' : 'text-mute hover:text-ink']} aria-label="LinkedIn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
