---
interface Props {
  name: string;
  role: string;
  photo?: string;
  linkedin?: string;
  instagram?: string;
}

const { name, role, photo, linkedin, instagram } = Astro.props;
---

<div class="team-card group scroll-animate">
  <!-- Name -->
  <h3 class="mb-2 text-lg font-bold uppercase tracking-wide text-ink">{name}</h3>
  
  <!-- Role badge -->
  <div class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-ink px-3 py-1 text-xs font-medium text-on-primary">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
    {role}
  </div>

  <!-- Photo -->
  <div class="relative mb-4 overflow-hidden rounded-xl border-4 border-link p-1">
    <div class="aspect-square overflow-hidden rounded-lg bg-hairline-soft">
      {photo ? (
        <img src={photo} alt={name} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
      ) : (
        <div class="flex h-full w-full items-center justify-center">
          <span class="text-5xl font-bold text-mute">{name.charAt(0)}</span>
        </div>
      )}
    </div>
  </div>

  <!-- Social links -->
  <div class="flex gap-3">
    {linkedin && (
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-hairline bg-canvas-elevated text-mute transition-all duration-300 hover:border-ink hover:bg-ink hover:text-on-primary"
        aria-label={`${name} LinkedIn`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
          <rect x="2" y="9" width="4" height="12"></rect>
          <circle cx="4" cy="4" r="2"></circle>
        </svg>
      </a>
    )}
    {instagram && (
      <a
        href={instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="flex h-10 w-10 items-center justify-center rounded-full border border-hairline bg-canvas-elevated text-mute transition-all duration-300 hover:border-ink hover:bg-ink hover:text-on-primary"
        aria-label={`${name} Instagram`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
          <circle cx="12" cy="12" r="5"></circle>
          <circle cx="17.5" cy="6.5" r="1.5" fill="currentColor" stroke="none"></circle>
        </svg>
      </a>
    )}
  </div>
</div>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background-color: var(--color-canvas-elevated);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: var(--spacing-lg);
    transition: all 0.3s ease;
  }

  .team-card:hover {
    box-shadow: var(--shadow-floating);
    transform: translateY(-4px);
  }
</style>
