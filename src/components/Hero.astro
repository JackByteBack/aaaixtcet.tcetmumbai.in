---
interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, heading, subheading, primaryCta, secondaryCta } = Astro.props;
---

<section class="relative overflow-hidden bg-canvas dark:bg-canvas">
  <!-- Mesh gradient blob -->
  <div class="hero-gradient pointer-events-none absolute left-1/2 top-0 h-56 w-56 -translate-x-1/2 rounded-full opacity-30 blur-3xl md:left-auto md:-right-24 md:top-[-6rem] md:h-96 md:w-96 md:translate-x-0 dark:opacity-15 animate-float" style="background: linear-gradient(135deg, #50e3c2, #0070f3, #7928ca, #ff0080, #f5a623);"></div>
  <div class="pointer-events-none absolute -bottom-16 -left-16 h-40 w-40 rounded-full opacity-15 blur-3xl md:-bottom-32 md:-left-32 md:h-72 md:w-72 dark:opacity-10 animate-float" style="background: linear-gradient(135deg, #7928ca, #ff0080); animation-delay: 1s;"></div>

  <div class="relative mx-auto px-6 pt-4 pb-8 md:py-20 lg:py-28" style="max-width: 1200px;">
    <div style="max-width: 640px;">
      {eyebrow && (
        <p class="mono-eyebrow mb-4 hero-animate" style="opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out, transform 0.6s ease-out;">{eyebrow}</p>
      )}
      <h1
        class="mb-6 font-semibold text-ink hero-animate"
        style="font-size: clamp(1.75rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.05em; opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out 0.1s, transform 0.6s ease-out 0.1s;"
      >
        {heading}
      </h1>
      {subheading && (
        <p
          class="mb-8 text-body hero-animate"
          style="font-size: 1rem; line-height: 1.625; max-width: 520px; opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out 0.2s, transform 0.6s ease-out 0.2s;"
        >
          {subheading}
        </p>
      )}
      {(primaryCta || secondaryCta) && (
        <div class="flex flex-wrap gap-3 hero-animate" style="opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease-out 0.3s, transform 0.6s ease-out 0.3s;">
          {primaryCta && (
            <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-secondary">{secondaryCta.label}</a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
