---
import GlowHorizonFM from "@/components/ui/glow-horizon";

interface Props {
  eyebrow?: string;
  heading: string;
  subheading?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, heading, subheading, primaryCta, secondaryCta } = Astro.props;
---

<section class="relative overflow-hidden bg-[#050507] min-h-screen min-h-[100dvh] flex items-center">
  <GlowHorizonFM client:load variant="top" />

  <div class="relative mx-auto px-6 py-20 md:py-28 lg:py-32" style="max-width: 1200px;">
    <div style="max-width: 640px;">
      {eyebrow && (
        <p class="mono-eyebrow mb-4 hero-animate" style="opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); color: #a0a0a0;">{eyebrow}</p>
      )}
      <h1
        class="mb-6 font-semibold hero-animate"
        style="font-size: clamp(1.75rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.05em; opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s; color: #ffffff;"
      >
        {heading}
      </h1>
      {subheading && (
        <p
          class="mb-8 hero-animate"
          style="font-size: 1rem; line-height: 1.625; max-width: 520px; opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s; color: #d0d0d0;"
        >
          {subheading}
        </p>
      )}
      {(primaryCta || secondaryCta) && (
        <div class="flex flex-wrap gap-3 hero-animate" style="opacity: 0; transform: translateY(24px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s;">
          {primaryCta && (
            <a href={primaryCta.href} class="btn-primary">{primaryCta.label}</a>
          )}
          {secondaryCta && (
            <a href={secondaryCta.href} class="btn-secondary">{secondaryCta.label}</a>
          )}
        </div>
      )}
    </div>
  </div>
</section>
