---
interface Props {
  hideThemeToggle?: boolean;
  dark?: boolean;
}

const { hideThemeToggle = false, dark = false } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/events', label: 'Events' },
  { href: '/team', label: 'Team' },
  { href: '/achievements', label: 'Achievements' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<nav class:list={[
  "sticky top-0 z-50 border-b",
  dark ? "border-[#2a2a2a] bg-black/90" : "border-white/10 bg-[#050507]/70 backdrop-blur-xl"
]}>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <div class="flex h-14 items-center justify-between">
      <a href="/" class:list={["flex items-center gap-2 no-underline", dark ? "text-white" : "text-white"]}>
        <span class="font-mono text-sm font-bold tracking-wide uppercase">TCET AAAI</span>
      </a>

      <!-- Desktop nav -->
      <div class="hidden items-center gap-1 md:flex">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'rounded-full px-3 py-1.5 text-sm no-underline transition-colors',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? dark ? 'text-white font-semibold' : 'text-white font-semibold'
                : dark ? 'text-gray-400 hover:text-white' : 'text-white/70 hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-2">
        <!-- Mobile menu button -->
        <button
          id="mobile-menu-toggle"
          class:list={[
            "flex h-11 w-11 items-center justify-center rounded-md md:hidden",
            dark ? "bg-[#1a1a1a] text-white" : "bg-white/10 text-white"
          ]}
          aria-label="Toggle menu"
        >
          <svg id="hamburger-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path id="line-top" d="M2 4h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="transition: all 0.3s ease; transform-origin: center;"/>
            <path id="line-mid" d="M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="transition: all 0.3s ease; transform-origin: center;"/>
            <path id="line-bot" d="M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style="transition: all 0.3s ease; transform-origin: center;"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class:list={[
      "absolute left-0 right-0 top-full border-t z-50 md:hidden",
      dark ? "border-[#2a2a2a] bg-black" : "border-white/10 bg-[#050507]/95 backdrop-blur-xl"
    ]} style="opacity: 0; pointer-events: none; transition: opacity 0.3s ease;">
      <div class="flex flex-col">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'px-4 py-3.5 text-sm no-underline transition-colors min-h-[44px] flex items-center',
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? dark ? 'bg-[#1a1a1a] text-white font-semibold' : 'bg-white/10 text-white font-semibold'
                : dark ? 'text-gray-400 hover:bg-[#1a1a1a] hover:text-white' : 'text-white/70 hover:bg-white/10 hover:text-white',
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const lineTop = document.getElementById('line-top');
  const lineMid = document.getElementById('line-mid');
  const lineBot = document.getElementById('line-bot');

  let isOpen = false;

  function closeMenu() {
    isOpen = false;
    menu?.style.setProperty('opacity', '0');
    menu?.style.setProperty('pointer-events', 'none');
    lineTop?.setAttribute('d', 'M2 4h12');
    lineMid?.setAttribute('d', 'M2 8h12');
    lineBot?.setAttribute('d', 'M2 12h12');
    lineMid?.setAttribute('opacity', '1');
  }

  function openMenu() {
    isOpen = true;
    menu?.style.setProperty('opacity', '1');
    menu?.style.setProperty('pointer-events', 'auto');
    lineTop?.setAttribute('d', 'M4 4L12 12');
    lineMid?.setAttribute('d', 'M8 8L8 8');
    lineBot?.setAttribute('d', 'M4 12L12 4');
    lineMid?.setAttribute('opacity', '0');
  }

  toggle?.addEventListener('click', () => {
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (e) => {
    if (isOpen && !menu?.contains(e.target as Node) && !toggle?.contains(e.target as Node)) {
      closeMenu();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) closeMenu();
  });
</script>
