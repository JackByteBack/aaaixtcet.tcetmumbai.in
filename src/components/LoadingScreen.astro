---
---

<div id="loading-screen" class="loading-screen" style="display: none;">
  <div class="loading-grid"></div>
  <div class="loading-content">
    <h1 class="loading-title">TCET AAAI</h1>
    <div class="loading-progress-container">
      <div class="loading-percentage">
        <span id="loading-percent">0</span><span class="loading-percent-symbol">%</span>
      </div>
      <div class="loading-bar-track">
        <div id="loading-bar" class="loading-bar-fill"></div>
      </div>
      <div class="loading-footer">
        <span class="loading-status">SYSTEM INITIALIZATION</span>
        <span class="loading-breadcrumb">TCET / AAAI</span>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const loadingScreen = document.getElementById('loading-screen');
    const loadingBar = document.getElementById('loading-bar');
    const loadingPercent = document.getElementById('loading-percent');
    
    // Only show on reload/refresh
    const navigationType = performance.getEntriesByType('navigation')[0]?.type;
    
    if (navigationType !== 'reload') {
      loadingScreen.style.display = 'none';
      return;
    }
    
    document.body.style.overflow = 'hidden';
    loadingScreen.style.display = 'flex';
    
    let progress = 0;
    const duration = 2500;
    const interval = 25;
    const increment = 100 / (duration / interval);
    
    const timer = setInterval(() => {
      progress += increment;
      if (progress >= 100) {
        progress = 100;
        clearInterval(timer);
        
        setTimeout(() => {
          loadingScreen.classList.add('fade-out');
          setTimeout(() => {
            loadingScreen.style.display = 'none';
            document.body.style.overflow = '';
          }, 500);
        }, 300);
      }
      
      loadingBar.style.width = progress + '%';
      loadingPercent.textContent = Math.floor(progress);
    }, interval);
  });
</script>