---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TeamCard from '../components/TeamCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const members = await getCollection('team');
const sortedMembers = members.sort((a, b) => a.data.order - b.data.order);

const officeBearers = sortedMembers.filter((m) =>
  ['President', 'Vice President', 'Secretary', 'Treasurer', 'Technical Head', 'Events Head', 'PR Head'].includes(m.data.role)
);
const otherMembers = sortedMembers.filter((m) =>
  !['President', 'Vice President', 'Secretary', 'Treasurer', 'Technical Head', 'Events Head', 'PR Head'].includes(m.data.role)
);
---

<Layout
  title="Team"
  description="Meet the team behind TCET AAAI — the office bearers and members driving the AI community at TCET."
>
  <Navbar />

  <Hero
    eyebrow="Our Team"
    heading="The People Behind TCET AAAI"
    subheading="A dedicated team of students passionate about making AI accessible and exciting for everyone at TCET."
  />

  <!-- Office Bearers -->
  <section class="border-t border-hairline bg-canvas">
    <div class="mx-auto max-w-[1200px] px-6 py-12 md:py-20 lg:py-24">
      <p class="mono-eyebrow mb-2">Leadership</p>
      <h2 class="mb-8 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
        Office Bearers
      </h2>
      {officeBearers.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {officeBearers.map((member) => (
            <TeamCard
              name={member.data.name}
              role={member.data.role}
              photo={member.data.photo}
              linkedin={member.data.linkedin}
              instagram={member.data.instagram}
            />
          ))}
        </div>
      ) : (
        <p class="text-body">Team information coming soon.</p>
      )}
    </div>
  </section>

  <!-- Other Members -->
  {otherMembers.length > 0 && (
    <section class="border-t border-hairline bg-canvas">
      <div class="mx-auto max-w-[1200px] px-6 py-12 md:py-20 lg:py-24">
        <p class="mono-eyebrow mb-2">Members</p>
        <h2 class="mb-8 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
          Core Team
        </h2>
        <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
          {otherMembers.map((member) => (
            <TeamCard
              name={member.data.name}
              role={member.data.role}
              photo={member.data.photo}
              linkedin={member.data.linkedin}
              instagram={member.data.instagram}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />
</Layout>
