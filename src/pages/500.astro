---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Server Error"
  description="Something went wrong on our end. Please try again later."
>
  <Navbar />

  <section class="flex min-h-[60vh] items-center justify-center bg-canvas">
    <div class="px-6 text-center">
      <p class="mono-eyebrow mb-2">500</p>
      <h1 class="mb-4 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
        Internal Server Error
      </h1>
      <p class="mx-auto mb-8 max-w-[28rem] text-body">
        Something went wrong on our end. Our team has been notified and is working to fix the issue. Please try again later.
      </p>
      <div class="flex justify-center gap-3">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="javascript:location.reload()" class="btn-secondary">Try Again</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
