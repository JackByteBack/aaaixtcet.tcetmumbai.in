---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((event) => ({
    params: { slug: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const { Content } = await render(event);

const formattedDate = event.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const accent = event.data.accentColor;
const gradient = event.data.heroGradient || `linear-gradient(135deg, ${accent}, ${accent}cc)`;
---

<Layout
  title={event.data.title}
  description={event.data.description}
  image={event.data.coverImage}
>
  <Navbar hideThemeToggle dark />

  <article>
    <!-- Themed hero banner -->
    <div class="relative overflow-hidden" style={event.id === 'murder-among-us' ? '' : `background: ${gradient};`}>
      {event.id === 'murder-among-us' ? (
        <>
          <img 
            src="/images/image.png" 
            alt="" 
            class="absolute inset-0 w-full object-cover blur-[2.5%]"
            style="height: 100%;"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/40 to-black/30"></div>
        </>
      ) : null}
      <!-- Decorative mesh blob -->
      <div class="pointer-events-none absolute -right-20 -top-20 h-80 w-80 rounded-full opacity-20 blur-3xl" style="background: rgba(255,255,255,0.3);"></div>
      <div class="pointer-events-none absolute -bottom-20 -left-20 h-60 w-60 rounded-full opacity-15 blur-3xl" style="background: rgba(255,255,255,0.2);"></div>

      <div class="relative mx-auto max-w-[1200px] px-6 py-6 md:py-16 lg:py-20">
        <!-- Back link -->
        <a href="/events" class="mb-6 inline-flex items-center gap-1 text-sm text-white/70 no-underline transition-colors hover:text-white">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="M12 19l-7-7 7-7"></path>
          </svg>
          All Events
        </a>

        <div class="flex flex-wrap items-center gap-3 mb-4">
          {event.data.category && (
            <span
              class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium"
              style={`background: rgba(255,255,255,0.2); color: white;`}
            >
              {event.data.category}
            </span>
          )}
          <time class="text-sm text-white/80">{formattedDate}</time>
        </div>

        <h1
          class="mb-4 font-semibold text-white"
          style="font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.15; letter-spacing: -0.04em;"
        >
          {event.data.title}
        </h1>

        <p class="mb-6 text-white/80" style="font-size: 1.05rem; line-height: 1.6; max-width: 640px;">
          {event.data.description}
        </p>

        <!-- Meta row -->
        <div class="flex flex-wrap gap-4 text-sm text-white/70">
          {event.data.venue && (
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              {event.data.venue}
            </span>
          )}
          {event.data.time && (
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 6v6l4 2"></path>
              </svg>
              {event.data.time}
            </span>
          )}
        </div>

        <!-- Tags -->
        {event.data.tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {event.data.tags.map((tag) => (
              <span
                class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium"
                style={`background: rgba(255,255,255,0.15); color: rgba(255,255,255,0.9); border: 1px solid rgba(255,255,255,0.2);`}
              >
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Content area -->
    <div class="relative bg-[#0a0a0a]">
      {event.id === 'murder-among-us' && (
        <img 
          src="/images/img.png" 
          alt="" 
          class="absolute inset-0 w-full object-cover blur-[8px] opacity-40"
          style="height: 100%;"
        />
      )}
      <div class="relative mx-auto max-w-[1200px] px-6 py-10 md:py-14">
        <div class="grid gap-10 lg:grid-cols-[1fr_320px] lg:gap-14">
          <!-- Main content -->
          <div class="prose prose-dark max-w-none">
            <Content />
          </div>

          <!-- Sidebar -->
          <aside class="lg:sticky lg:top-20 lg:self-start">
            <div
              class="rounded-2xl border border-[#2a2a2a] bg-[#141414] p-6"
              style={`border-top: 3px solid ${accent};`}
            >
              <h3 class="mb-4 text-sm font-semibold text-[#f0f0f0]">Event Info</h3>

              <div class="flex flex-col gap-3 text-sm">
                <div class="flex items-center gap-2.5 text-[#b0b0b0]">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="16" y1="2" x2="16" y2="6"></line>
                    <line x1="8" y1="2" x2="8" y2="6"></line>
                    <line x1="3" y1="10" x2="21" y2="10"></line>
                  </svg>
                  <span>{formattedDate}</span>
                </div>

                {event.data.time && (
                  <div class="flex items-center gap-2.5 text-[#b0b0b0]">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="M12 6v6l4 2"></path>
                    </svg>
                    <span>{event.data.time}</span>
                  </div>
                )}

                {event.data.venue && (
                  <div class="flex items-center gap-2.5 text-[#b0b0b0]">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                      <circle cx="12" cy="10" r="3"></circle>
                    </svg>
                    <span>{event.data.venue}</span>
                  </div>
                )}

                {event.data.category && (
                  <div class="flex items-center gap-2.5 text-[#b0b0b0]">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 7V4h16v3"></path>
                      <path d="M9 20h6"></path>
                      <path d="M12 4v16"></path>
                    </svg>
                    <span>{event.data.category}</span>
                  </div>
                )}
              </div>

              {event.data.registrationUrl ? (
                <a
                  href={event.data.registrationUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 block w-full rounded-full py-2.5 text-center text-sm font-medium text-black no-underline transition-opacity hover:opacity-90"
                  style={`background: ${accent};`}
                >
                  Register Now
                </a>
              ) : event.data.registrationMessage ? (
                <p class="mt-5 block w-full rounded-full py-2.5 text-center text-sm font-medium text-[#b0b0b0] border border-[#2a2a2a] bg-[#141414]">
                  {event.data.registrationMessage}
                </p>
              ) : null}

              {!event.data.upcoming && (
                <p class="mt-3 text-xs text-[#707070] text-center">This event has concluded</p>
              )}
            </div>

            <!-- Share -->
            <div class="mt-4 rounded-2xl border border-[#2a2a2a] bg-[#141414] p-6">
              <h3 class="mb-3 text-sm font-semibold text-[#f0f0f0]">Share</h3>
              <div class="flex gap-2">
                {event.data.github && (
                  <a
                    href={event.data.github.startsWith('http') ? event.data.github : `https://github.com/${event.data.github}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 rounded-full border border-[#2a2a2a] bg-[#1a1a1a] py-2 text-center text-xs font-medium text-[#b0b0b0] no-underline transition-colors hover:bg-[#2a2a2a] hover:text-[#f0f0f0]"
                  >
                    GitHub
                  </a>
                )}
                {event.data.linkedin && (
                  <a
                    href={event.data.linkedin.startsWith('http') ? event.data.linkedin : `https://linkedin.com/in/${event.data.linkedin}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 rounded-full border border-[#2a2a2a] bg-[#1a1a1a] py-2 text-center text-xs font-medium text-[#b0b0b0] no-underline transition-colors hover:bg-[#2a2a2a] hover:text-[#f0f0f0]"
                  >
                    LinkedIn
                  </a>
                )}
                {!event.data.github && !event.data.linkedin && (
                  <a
                    href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 rounded-full border border-[#2a2a2a] bg-[#1a1a1a] py-2 text-center text-xs font-medium text-[#b0b0b0] no-underline transition-colors hover:bg-[#2a2a2a] hover:text-[#f0f0f0]"
                  >
                    LinkedIn
                  </a>
                )}
              </div>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </article>

  <Footer dark />
</Layout>
