---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import CTABand from '../components/CTABand.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About"
  description="Learn about TCET AAAI — the official BCA department AI student chapter at Thakur College of Engineering & Technology, affiliated with AAAI. We are a community of 200+ BCA students passionate about artificial intelligence, machine learning, and the future of technology."
>
  <Navbar />

  <Hero
    eyebrow="About Us"
    heading="What is TCET AAAI?"
    subheading="TCET AAAI is the official BCA department student chapter of the Association for the Advancement of Artificial Intelligence (AAAI) at Thakur College of Engineering & Technology, Mumbai."
  />

  <!-- Mission & Affiliation -->
  <section class="border-t border-hairline bg-canvas">
    <div class="mx-auto max-w-[1200px] px-6 py-12 md:py-20 lg:py-24">
      <div class="grid gap-8 md:grid-cols-2 md:gap-12">
        <div class="scroll-animate-left">
          <p class="mono-eyebrow mb-2">Our Mission</p>
          <h2 class="mb-4 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
            Democratizing AI Education
          </h2>
          <p class="mb-4 text-body">
            We believe artificial intelligence should be accessible to every BCA student, not just those in
            specialized CS programs. Our chapter bridges the gap between theory and practice, making AI approachable
            for all backgrounds.
          </p>
          <p class="text-body">
            Through workshops, hands-on projects, speaker sessions, and competitions, we create an
            environment where BCA students can explore, experiment, and excel in AI — regardless of their
            experience level.
          </p>
        </div>
        <div class="scroll-animate-right">
          <p class="mono-eyebrow mb-2">Affiliation</p>
          <h2 class="mb-4 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
            Part of a Global Network
          </h2>
          <p class="mb-4 text-body">
            TCET AAAI is the official BCA department student chapter of the Association for the Advancement of
            Artificial Intelligence (AAAI) — the world's leading professional society for AI research
            and education. Operating under the Department of Computer Applications at TCET, we serve
            as the primary AI community for BCA students.
          </p>
          <p class="text-body">
            This affiliation connects our members to a global community of AI researchers, practitioners,
            and students. Members gain access to AAAI resources, publications, conferences, and a
            network that spans across universities and industries worldwide.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-hairline bg-canvas">
    <div class="mx-auto grid max-w-[1200px] grid-cols-2 gap-6 px-6 py-8 md:grid-cols-4 md:gap-8 md:py-16">
      <div class="text-center">
        <p class="text-3xl font-semibold text-ink md:text-4xl">200+</p>
        <p class="mt-1 text-sm text-mute">Active Members</p>
      </div>
      <div class="text-center">
        <p class="text-3xl font-semibold text-ink md:text-4xl">30+</p>
        <p class="mt-1 text-sm text-mute">Events Held</p>
      </div>
      <div class="text-center">
        <p class="text-3xl font-semibold text-ink md:text-4xl">2023</p>
        <p class="mt-1 text-sm text-mute">Founded</p>
      </div>
      <div class="text-center">
        <p class="text-3xl font-semibold text-ink md:text-4xl">15+</p>
        <p class="mt-1 text-sm text-mute">Workshops</p>
      </div>
    </div>
  </section>

  <!-- What We Do -->
  <section class="border-t border-hairline bg-canvas">
    <div class="mx-auto max-w-[1200px] px-6 py-12 md:py-20 lg:py-24">
      <div class="scroll-animate">
        <p class="mono-eyebrow mb-2">What We Do</p>
        <h2 class="mb-8 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
          Building the AI Community at TCET
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        <div class="feature-card scroll-animate-left delay-100">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-hairline-soft">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-semibold text-ink">Workshops & Training</h3>
          <p class="text-sm leading-6 text-body">
            Hands-on workshops on ML, deep learning, NLP, computer vision, and generative AI for BCA students.
          </p>
        </div>
        <div class="feature-card scroll-animate delay-200">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-hairline-soft">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-semibold text-ink">Speaker Sessions</h3>
          <p class="text-sm leading-6 text-body">
            Industry experts share insights on cutting-edge AI topics and career paths for BCA students.
          </p>
        </div>
        <div class="feature-card scroll-animate delay-300">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-hairline-soft">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-semibold text-ink">Hackathons</h3>
          <p class="text-sm leading-6 text-body">
            Compete, collaborate, and build innovative AI solutions in team-based hackathons.
          </p>
        </div>
        <div class="feature-card scroll-animate-right delay-400">
          <div class="mb-3 flex h-10 w-10 items-center justify-center rounded-md bg-hairline-soft">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-ink">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="mb-2 text-sm font-semibold text-ink">Community</h3>
          <p class="text-sm leading-6 text-body">
            Peer learning, study groups, and project collaborations in a supportive ecosystem.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Focus Areas -->
  <section class="border-t border-hairline bg-canvas">
    <div class="mx-auto max-w-[1200px] px-6 py-12 md:py-20 lg:py-24">
      <div class="scroll-animate">
        <p class="mono-eyebrow mb-2">Focus Areas</p>
        <h2 class="mb-8 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
          What We Explore
        </h2>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {[
          { title: 'Machine Learning', desc: 'Supervised, unsupervised, and reinforcement learning techniques.' },
          { title: 'Deep Learning', desc: 'Neural networks, CNNs, RNNs, Transformers, and architectures.' },
          { title: 'Natural Language Processing', desc: 'Text analysis, language models, and conversational AI.' },
          { title: 'Computer Vision', desc: 'Image recognition, object detection, and visual AI systems.' },
          { title: 'Generative AI', desc: 'LLMs, diffusion models, and creative AI applications.' },
          { title: 'AI Ethics', desc: 'Responsible AI, fairness, transparency, and societal impact.' },
          { title: 'Data Science', desc: 'Data analysis, visualization, and statistical modeling.' },
          { title: 'Robotics', desc: 'Autonomous systems, perception, and robotic learning.' },
        ].map((topic, i) => (
          <div class={`feature-card scroll-animate delay-${(i % 4 + 1) * 100}`}>
            <h3 class="mb-1 text-sm font-semibold text-ink">{topic.title}</h3>
            <p class="text-xs leading-5 text-body">{topic.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Faculty Coordinators -->
  <section class="border-t border-hairline bg-canvas">
    <div class="mx-auto max-w-[1200px] px-6 py-12 md:py-20 lg:py-24">
      <div class="scroll-animate">
        <p class="mono-eyebrow mb-2">Guidance</p>
        <h2 class="mb-8 font-semibold text-ink" style="font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.25; letter-spacing: -0.04em;">
          Faculty Coordinators
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="feature-card scroll-animate-left delay-100">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-hairline-soft">
              <span class="text-lg font-semibold text-mute">F</span>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-ink">Faculty Coordinator</h3>
              <p class="text-xs text-mute">Department of Computer Applications, TCET</p>
            </div>
          </div>
          <p class="mt-4 text-sm leading-6 text-body">
            Guiding the chapter's vision, organizing events, and mentoring BCA students in their AI journey.
          </p>
        </div>
        <div class="feature-card scroll-animate-right delay-200">
          <div class="flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-full bg-hairline-soft">
              <span class="text-lg font-semibold text-mute">F</span>
            </div>
            <div>
              <h3 class="text-sm font-semibold text-ink">Co-Coordinator</h3>
              <p class="text-xs text-mute">Department of Computer Applications, TCET</p>
            </div>
          </div>
          <p class="mt-4 text-sm leading-6 text-body">
            Supporting chapter operations, coordinating with industry partners, and overseeing BCA student projects.
          </p>
        </div>
      </div>
    </div>
  </section>

  <CTABand
    heading="Want to be part of TCET AAAI?"
    subheading="Join our community of BCA students passionate about AI. No prior experience needed — just curiosity."
    ctaLabel="Contact Us"
    ctaHref="/contact"
  />

  <Footer />
</Layout>
